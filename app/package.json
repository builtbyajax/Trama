{
  "name": "trama",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test:scripts": "node --test scripts/*.test.mjs",
    "tauri": "node scripts/tauri.mjs",
    "predev": "node scripts/prepare-dev.mjs",
    "format:check": "prettier --check src scripts vite.config.ts vitest.config.ts playwright.config.ts e2e",
    "format": "prettier --write src scripts vite.config.ts vitest.config.ts playwright.config.ts e2e",
    "test": "vitest run && npm run test:scripts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/prepare-dev.mjs && playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
